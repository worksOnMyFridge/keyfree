    "check:claims": "node tools/check_claims.mjs"
  },
  "devDependencies": {
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "binaryen": "132.0.0",
    "near-api-js": "7.3.1",
    "near-sandbox": "0.3.4",
    "solc": "0.8.28",
    "viem": "2.57.11"
  }
}
